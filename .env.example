# BABEL configuration. Copy to .env and fill in what you use. Never commit .env.
#
# BABEL works with no keys at all (rules + memory). Two optional model tiers raise quality:
#   local  — Ollama on this machine (free): just run it with a model pulled, e.g. `ollama pull qwen3:30b-a3b` (32 GB+ RAM) or `ollama pull qwen3:8b`
#   cloud  — any provider below; only asked about lines the cheaper tiers couldn't settle
# Cloud providers form a fallback chain in the order listed under BABEL_PROVIDERS.
#
# Any *_API_KEYS variable accepts a comma-separated list — keys are rotated automatically
# when one hits its rate limit, which is the main way to go faster on free tiers.

# ── Providers (all free tiers are fine) ────────────────────────────────────
# NVIDIA NIM — https://build.nvidia.com (keys start with nvapi-)
NVIDIA_API_KEYS=
# Groq — https://console.groq.com
GROQ_API_KEYS=
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# OpenRouter — https://openrouter.ai/keys  (":free" models)
OPENROUTER_API_KEYS=
# OpenAI — paid
OPENAI_API_KEYS=

# ── Local tier (Ollama) ─────────────────────────────────────────────────────
# BABEL_LOCAL=auto              # auto (use Ollama if running) | off
# BABEL_LOCAL_MODEL=qwen3:30b-a3b  # default: best installed of qwen3:30b-a3b, qwen3:8b, qwen3:14b, …
# OLLAMA_BASE_URL=http://localhost:11434

# Any other OpenAI-compatible server (LM Studio, vLLM, llama.cpp server, ...)
# BABEL_CUSTOM_BASE_URL=http://localhost:1234/v1
# BABEL_CUSTOM_MODEL=your-model
# BABEL_CUSTOM_API_KEY=

# ── Choosing providers / models (optional) ─────────────────────────────────
# Order of the cloud chain. Default: every configured provider in the order
# nvidia, groq, gemini, openrouter, openai, custom. "none" = no cloud tier.
# BABEL_PROVIDERS=groq,nvidia
# Model per provider (defaults shown)
# BABEL_NVIDIA_MODEL=deepseek-ai/deepseek-v3.1
# BABEL_GROQ_MODEL=llama-3.3-70b-versatile
# BABEL_GEMINI_MODEL=gemini-2.5-flash
# BABEL_OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
# BABEL_OPENAI_MODEL=gpt-4.1-mini
# Requests/minute per key (defaults: nvidia 40, groq 30, openrouter 20, gemini 10)
# BABEL_GROQ_RPM=30

# ── Cascade policy ─────────────────────────────────────────────────────────
# BABEL_ACCEPT=0.9             # decisions at/above this confidence are final without asking a model
# BABEL_ESCALATE=0.75          # after the local tier, lines below this go to the cloud
# BABEL_REVIEW=0.6             # below this, a line goes to your review queue
# BABEL_SUMMARIES=local        # local | cloud | off — chapter summaries for "story so far" memory

# ── Character art (Apple Silicon; set up with `babel art setup`) ───────────
# BABEL_ART=auto                # auto (use .venv-art if it exists) | off
# BABEL_ART_PYTHON=.venv-art/bin/python

# ── Pipeline ───────────────────────────────────────────────────────────────
# BABEL_DATA_DIR=data          # library database, covers, portraits
# BABEL_CONCURRENCY=2          # chapters in flight per novel
# BABEL_PARALLEL_NOVELS=2      # novels transformed at the same time
# BABEL_SUMMARY_WINDOW=3       # previous-chapter summaries given as context
# GOOGLE_BOOKS_API_KEY=        # optional, for metadata search
# BABEL_HOST=127.0.0.1
# BABEL_PORT=8000
