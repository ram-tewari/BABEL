# BABEL configuration. Copy to .env and fill in what you use. Never commit .env.
#
# BABEL works with NO keys at all (offline heuristic labeling). An LLM makes speaker
# attribution far better. Configure one or more providers; they're tried in order and
# fall back to the next one when rate-limited or failing.
#
# Any *_API_KEYS variable accepts a comma-separated list — keys are rotated automatically
# when one hits its rate limit, which is the main way to go faster on free tiers.

# ── Providers (all free tiers are fine) ────────────────────────────────────
# NVIDIA NIM — https://build.nvidia.com (keys start with nvapi-)
NVIDIA_API_KEYS=
# Groq — https://console.groq.com
GROQ_API_KEYS=
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# OpenRouter — https://openrouter.ai/keys  (":free" models)
OPENROUTER_API_KEYS=
# OpenAI — paid
OPENAI_API_KEYS=

# Local Ollama (auto-detected when running) — `ollama pull qwen2.5:7b`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Any other OpenAI-compatible server (LM Studio, vLLM, llama.cpp server, ...)
# BABEL_CUSTOM_BASE_URL=http://localhost:1234/v1
# BABEL_CUSTOM_MODEL=your-model
# BABEL_CUSTOM_API_KEY=

# ── Choosing providers / models (optional) ─────────────────────────────────
# Order of the fallback chain. Default: every configured provider in the order
# nvidia, groq, gemini, openrouter, openai, custom, ollama. "none" = offline only.
# BABEL_PROVIDERS=groq,nvidia
# Model per provider (defaults shown)
# BABEL_NVIDIA_MODEL=qwen/qwen3-235b-a22b
# BABEL_GROQ_MODEL=llama-3.3-70b-versatile
# BABEL_GEMINI_MODEL=gemini-2.5-flash
# BABEL_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# BABEL_OPENAI_MODEL=gpt-4.1-mini
# Requests/minute per key (defaults: nvidia 40, groq 30, openrouter 20, gemini 10)
# BABEL_GROQ_RPM=30

# ── Pipeline ───────────────────────────────────────────────────────────────
# BABEL_DATA_DIR=data          # library database + covers
# BABEL_CONCURRENCY=2          # chapters in flight at once
# BABEL_CHUNK_TOKENS=6000      # max source tokens per LLM request
# BABEL_SUMMARY_WINDOW=3       # previous-chapter summaries given as context
# BABEL_HOST=127.0.0.1
# BABEL_PORT=8000
